# Base URL of the backend API, including the /api prefix. No trailing slash.
VITE_API_URL=http://localhost:5000/api
# ISO 4217 currency code used for prices (e.g. USD, EUR, GBP, TRY).
VITE_CURRENCY=USD
# Store name shown in the sidebar, the login page and the browser tab.
VITE_SITE_NAME=Store

# VITE_ variables are embedded in the public JS bundle at build time.
# Never put secrets here, and rebuild/redeploy after changing them.